# Local configuration; never commit real credentials.
SECRET_KEY=change-me-to-a-random-secret-of-at-least-32-characters
DATABASE_URL=sqlite:///./swinglens.db
# Public deployments require PostgreSQL; Vercel Neon integration sets DATABASE_URL.
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require
LLM_PROVIDER=gemini,groq
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional legacy key pools (one request per provider per chat).
GEMINI_API_KEYS=
GROQ_API_KEYS=
GEMINI_MODEL=gemini-3.1-flash-lite
GROQ_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT_SECONDS=20
LLM_MAX_OUTPUT_TOKENS=2048
CHAT_REQUESTS_PER_MINUTE=10
CORS_ORIGINS=http://localhost:5173
ACCESS_TOKEN_EXPIRE_MINUTES=10080
DEMO_MODE=0
