# Copy this file to .env (Windows: copy .env.example .env)

# Security: change this to any long random string before first run
SECRET_KEY=change-me-to-a-long-random-string

# Database (SQLite file created automatically in the backend folder)
DATABASE_URL=sqlite:///./swinglens.db

# Hosted LLM: one provider or an ordered failover list.
LLM_PROVIDER=gemini,groq
# Add multiple keys separated by commas. Never commit real keys.
GEMINI_API_KEYS=
GROQ_API_KEYS=
XAI_API_KEYS=
# Backward-compatible single-key setting:
CLOUD_LLM_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_MODEL=llama-3.3-70b-versatile
# Backward-compatible model variable; provider-specific values above win.
CLOUD_LLM_MODEL=gemini-3.8-flash

# Only used for the legacy LLM_PROVIDER=cloud setting.
CLOUD_LLM_PROVIDER=groq
CLOUD_LLM_BASE_URL=https://api.groq.com/openai/v1

# Token lifetime in minutes (default: 7 days)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Showcase / hackathon options
DEMO_MODE=0
# DEMO_PASSWORD=swingdemo123
