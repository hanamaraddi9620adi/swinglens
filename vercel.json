{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --prefix frontend",
  "buildCommand": "npm run build --prefix frontend",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "excludeFiles": "{backend/venv/**,backend/tests/**,backend/scripts/**,frontend/node_modules/**,frontend/src/**,sample_data/**,**/*.db,**/.env,**/*.log}"
    }
  },
  "rewrites": [
    {"source": "/api/:path*", "destination": "/api/index"},
    {"source": "/docs", "destination": "/api/index"},
    {"source": "/openapi.json", "destination": "/api/index"},
    {"source": "/((?!api/|assets/|docs|openapi.json).*)", "destination": "/index.html"}
  ],
  "headers": [{"source": "/(.*)", "headers": [
    {"key": "X-Content-Type-Options", "value": "nosniff"},
    {"key": "X-Frame-Options", "value": "DENY"},
    {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"}
  ]}]
}
